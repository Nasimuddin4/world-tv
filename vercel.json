{
  "outputDirectory": "site",
  "trailingSlash": true,
  "headers": [
    { "source": "/data.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }] },
    { "source": "/(og.png|favicon.svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
